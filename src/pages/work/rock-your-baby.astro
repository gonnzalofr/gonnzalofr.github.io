    <dl class="meta col-full">
      <div class="meta__cell"><dt>Role</dt><dd>Team project · 5EWC0 · first year</dd></div>
      <div class="meta__cell"><dt>Stack</dt><dd>C · libpynq</dd></div>
      <div class="meta__cell"><dt>Board</dt><dd>PYNQ-Z2 ×4</dd></div>
      <div class="meta__cell"><dt>Status</dt><dd>complete — first-year project · <span class="nb">2025 – 26</span></dd></div>
    </dl>
