          <rect class="crisp" x="0" y="150" width="230" height="40"/>
          <text class="t-ink" x="12" y="175">crying</text>
          <text x="0" y="210">ADC → RMS − noise floor</text>
          <text x="0" y="228">three pthreads</text>
          <text x="0" y="246">PYNQ-Z2</text>
          <!-- decision-making: box (320,85) 220 × 40 -->
          <rect class="crisp" x="320" y="85" width="220" height="40"/>
          <text class="t-ink" x="332" y="110">decision-making</text>
          <text x="320" y="145">fuse → frequency 1–5,</text>
          <text x="320" y="163">amplitude 1–5 → UART</text>
          <text x="320" y="183">PYNQ-Z2</text>
          <!-- actuator: box (600,85) 190 × 40, ends 790 -->
          <rect class="crisp" x="600" y="85" width="190" height="40"/>
          <text class="t-ink" x="612" y="110">actuator</text>
          <text x="600" y="145">PWM 1 → frequency</text>
          <text x="600" y="163">PWM 2 → amplitude</text>
          <text x="600" y="183">PYNQ-Z2</text>
          <!-- UART links -->
          <line class="geo" x1="230" y1="40" x2="320" y2="100" marker-end="url(#arr)"/>
          <text x="272" y="58">UART</text>
          <line class="geo" x1="230" y1="170" x2="320" y2="110" marker-end="url(#arr)"/>
          <text x="272" y="166">UART</text>
          <line class="crisp" x1="540" y1="105" x2="600" y2="105" marker-end="url(#arr)"/>
