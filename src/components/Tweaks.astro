---
// Dev-only tweaks bar (rendered only under `npm run dev`; Base.astro gates it with import.meta.env.DEV, so it never
// reaches dist/). Each control writes one custom property on :root that site.css already reads; "Copy values" gives
// the settings as CSS to paste back into section 1 of site.css. Settings persist in localStorage for this browser only.
---
<aside class="tw" aria-label="Design tweaks (development only)">
  <button class="tw__toggle" type="button" aria-expanded="false" aria-controls="tw-panel">tweaks</button>
  <div class="tw__panel" id="tw-panel" hidden>
    <label>name size <input type="range" data-var="--k-name" min="0.6" max="1.6" step="0.02" value="1"><output></output></label>
    <label>name width <input type="range" data-var="--name-wdth" min="100" max="150" step="1" value="150"><output></output></label>
    <label>name weight <input type="range" data-var="--name-wght" min="500" max="900" step="10" value="800"><output></output></label>
    <label>text size <input type="range" data-var="--k-text" min="0.85" max="1.25" step="0.01" value="1"><output></output></label>
    <label>density <input type="range" data-var="--k-space" min="0.6" max="1.5" step="0.02" value="1"><output></output></label>
    <label>motion <input type="range" data-var="--k-motion" min="0" max="3" step="0.25" value="1"><output></output></label>
    <label>warmth <input type="range" data-warm min="0" max="1" step="0.05" value="1"><output></output></label>
    <p class="tw__row"><button type="button" data-reset>Reset</button> <button type="button" data-copy>Copy values</button></p>
    <textarea readonly rows="4" aria-label="Current values as CSS"></textarea>
  </div>
</aside>
<style is:inline>
  .tw { position: fixed; left: 12px; bottom: 12px; z-index: 100; font: 12px/1.3 ui-monospace, Consolas, monospace; color: #111; }
  .tw__toggle { font: inherit; background: #fff; color: #111; border: 1px solid #111; padding: 6px 10px; cursor: pointer; }
  .tw__panel { margin-top: 6px; background: #fff; border: 1px solid #111; padding: 10px; width: 280px; display: grid; gap: 6px; }
  .tw__panel[hidden] { display: none; }
  .tw label { display: grid; grid-template-columns: 6.5em 1fr 3.2em; align-items: center; gap: 6px; }
  .tw input[type="range"] { width: 100%; }
  .tw output { text-align: right; }
  .tw__row { margin: 4px 0 0; display: flex; gap: 6px; }
  .tw button { font: inherit; background: #fff; color: #111; border: 1px solid #111; padding: 4px 8px; cursor: pointer; }
  .tw textarea { font: 11px/1.3 ui-monospace, Consolas, monospace; width: 100%; resize: vertical; }
</style>
<script is:inline>
(function () {
  const root = document.documentElement;
  const panel = document.getElementById('tw-panel');
  const toggle = document.querySelector('.tw__toggle');
  const inputs = [...document.querySelectorAll('.tw input[type="range"]')];
  const out = document.querySelector('.tw textarea');
  const KEY = 'tweaks-v1';
  // warmth 0 = the neutral grounds of the first E, 1 = E2 (the owner's pick)
  const neutral = { '--g-black': '#0A0A0A', '--g-paper': '#FAFAFA', '--g-sand': '#E6E2D6', '--g-walnut': '#16181A', '--g-dusk': '#D5DDE0', '--ink-light': '#F2F2EE', '--ink-dark': '#121212', '--dim-light': '#A3A39C', '--dim-dark': '#53534E' };
  const warm = { '--g-black': '#120E0B', '--g-paper': '#F3EEE4', '--g-sand': '#E7DBC3', '--g-walnut': '#241B15', '--g-dusk': '#E8D2AE', '--ink-light': '#F4ECDF', '--ink-dark': '#1C150F', '--dim-light': '#B3A796', '--dim-dark': '#5E5244' };
  const hex = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  const mix = (a, b, t) => '#' + hex(a).map((v, i) => Math.round(v + (hex(b)[i] - v) * t).toString(16).padStart(2, '0')).join('').toUpperCase();
  function apply() {
    const vals = {};
    for (const i of inputs) {
      i.nextElementSibling.value = i.value;
      if (i.dataset.var) { root.style.setProperty(i.dataset.var, i.value); vals[i.dataset.var] = i.value; }
      else if (i.hasAttribute('data-warm')) {
        const t = +i.value;
        for (const k of Object.keys(warm)) { const c = mix(neutral[k], warm[k], t); root.style.setProperty(k, c); vals[k] = c; }
      }
    }
    out.value = ':root {\n' + Object.entries(vals).map(([k, v]) => `  ${k}: ${v};`).join('\n') + '\n}';
    try { localStorage.setItem(KEY, JSON.stringify(inputs.map((i) => i.value))); } catch (e) {}
  }
  try { const saved = JSON.parse(localStorage.getItem(KEY) || 'null'); if (saved) saved.forEach((v, k) => { if (inputs[k]) inputs[k].value = v; }); } catch (e) {}
  inputs.forEach((i) => i.addEventListener('input', apply));
  toggle.addEventListener('click', () => { const open = panel.hidden; panel.hidden = !open; toggle.setAttribute('aria-expanded', String(open)); });
  document.querySelector('[data-reset]').addEventListener('click', () => { inputs.forEach((i) => (i.value = i.defaultValue)); apply(); });
  document.querySelector('[data-copy]').addEventListener('click', () => { out.select(); navigator.clipboard?.writeText(out.value).catch(() => {}); });
  apply();
})();
</script>
