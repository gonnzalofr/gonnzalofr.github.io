---
// A case study's header: kicker (context · dates), name, deck, the lead figure (the slot), and the four metadata cells.
import type { Project } from '@portfolio/content';
import { views } from '@portfolio/content';
import Inline from './Inline.astro';
interface Props { project: Project }
const { project: p } = Astro.props;
const cells = [
  { label: 'Role', html: p.case.role },
  { label: 'Stack', html: p.case.stack },
  { label: 'Board', html: p.case.board },
  { label: 'Status', html: views.caseStatus(p) },
];
---
<section class="page cs">
  <p class="kicker col-head"><Inline html={views.caseKicker(p)} /></p>
  <h1 class="col-head">{p.name}</h1>
  <p class="deck col-prose"><Inline html={p.case.deck} /></p>
  <slot />
  <dl class="meta col-full">
    {cells.map((c) => <div class="meta__cell"><dt>{c.label}</dt><dd><Inline html={c.html} /></dd></div>)}
  </dl>
</section>
