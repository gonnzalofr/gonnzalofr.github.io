---
// Dated entries, newest first: a date beside a role and a line about it (CV education, projects, experience).
import { views, type Range } from '@portfolio/content';
import Inline from './Inline.astro';
interface Props { entries: { dates: Range; role: string; text: string }[] }
---
<div class="rec col-prose">
  {Astro.props.entries.map((e) => (
  <div class="rec__entry">
    <p class="rec__date"><Inline html={views.cvDate(e)} /></p>
    <div class="rec__body">
      <h3 class="rec__role"><Inline html={e.role} /></h3>
      <p class="rec__org"><Inline html={e.text} /></p>
    </div>
  </div>
  ))}
</div>
