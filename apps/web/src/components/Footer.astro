---
// Contact: the footer of every page.
// The confirmed internship line appears here, once per page (person.contact in @portfolio/content).
import { person, fullName, views } from '@portfolio/content';
import Inline from './Inline.astro';
import { rootPrefix } from '../lib/paths';
const P = rootPrefix(Astro.url, Astro.site);
---
<footer class="foot page" id="contact">
  <hr class="sec__rule col-full">
  <h2 class="foot__h">Contact</h2>
  <p class="col-prose"><Inline html={person.contact} /></p>
  <dl class="meta col-full">
    <div class="meta__cell"><dt>Email</dt><dd><a href={`mailto:${person.email}`}>{person.email}</a></dd></div>
    <div class="meta__cell"><dt>CV</dt><dd><a href={`${P}${person.cvPdf.path}`}>{person.cvPdf.label}</a></dd></div>
    <div class="meta__cell"><dt>Links</dt><dd>{person.links.map((l, i) => <Fragment>{i > 0 && <br>}<a href={l.href} rel="noopener">{l.label} <span aria-hidden="true">↗</span></a></Fragment>)}</dd></div>
    <div class="meta__cell"><dt>Study</dt><dd><Inline html={views.footerStudy} /></dd></div>
  </dl>
  <p class="foot__colophon">© {person.revised.slice(0, 4)} {fullName} · {person.city} <span>Last revised {views.revised}</span></p>
</footer>
