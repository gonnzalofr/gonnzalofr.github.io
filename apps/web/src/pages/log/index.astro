---
import Document from '../../layouts/Document.astro';
import LogIndex from '../../screens/LogIndex';
import { getCollection } from 'astro:content';
import { isPublished } from '../../lib/placeholder';
import { siteFor } from '../../lib/site';

const entries = (await getCollection('log', isPublished))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((e) => ({ id: e.id, ...e.data }));
---
<Document
  title="Log — Gonzalo Ferrero Martín"
  description="A bench log: dated entries on what is on the bench and what changed, with the photographs and renders that show it."
  current="log"
  noindex={entries.length === 0}
  ground="paper"
>
<LogIndex site={siteFor(Astro.url, Astro.site)} entries={entries} />
</Document>
