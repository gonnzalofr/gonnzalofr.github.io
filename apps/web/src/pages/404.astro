---
import Base from '../layouts/Base.astro';
import { projects, views } from '@portfolio/content';
// GitHub Pages serves this for any missing address, at any depth, so every link on it is absolute (depth 'abs').
const S = new URL('./', Astro.site).href;
---
<Base
  title="Not found — Gonzalo Ferrero Martín"
  description="This address has no page. The site's work, CV and contact are linked from here."
  kind="other"
  depth="abs"
  noindex
  ground="black"
>
<main id="main">

  <section class="page cs">
    <p class="kicker col-head">404 · not found</p>
    <h1 class="col-head">Nothing at this address</h1>
    <p class="deck col-prose">The page may have moved. Everything on the site starts from one of these:</p>
  </section>

  <section class="page sec">
    <ul class="more col-prose">
      <li><a href={`${S}work/index.html`}>All work</a> <span>{views.notFoundAllWork}</span></li>
      {projects.map((p) => <li><a href={`${S}work/${p.slug}.html`}>{p.name}</a> <span>{p.notFound.stack}</span></li>)}
      <li><a href={`${S}cv.html`}>CV</a> <span>one A4 page</span></li>
      <li><a href="#contact">Contact</a> <span>email · GitHub · LinkedIn</span></li>
    </ul>
  </section>

</main>
</Base>
