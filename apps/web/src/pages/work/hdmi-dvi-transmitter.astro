---
import Document from '../../layouts/Document.astro';
import HdmiDviTransmitter from '../../screens/work/HdmiDviTransmitter';
import { TmdsEncoder } from '@portfolio/ui/islands/tmds-encoder';
import { project, views } from '@portfolio/content';
import { siteFor } from '../../lib/site';
const p = project('hdmi-dvi-transmitter');
---
<Document title={views.caseTitle(p)} description={p.description} current="work-case" ground={p.ground}>
<HdmiDviTransmitter site={siteFor(Astro.url, Astro.site)}>
<TmdsEncoder slot="encoder" client:visible />
</HdmiDviTransmitter>
</Document>
