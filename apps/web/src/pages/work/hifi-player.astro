---
import Document from '../../layouts/Document.astro';
import HifiPlayer from '../../screens/work/HifiPlayer';
import { project, views } from '@portfolio/content';
import { siteFor } from '../../lib/site';
const p = project('hifi-player');
---
<Document title={views.caseTitle(p)} description={p.description} current="work-case" ground={p.ground}>
<HifiPlayer site={siteFor(Astro.url, Astro.site)} />
<script src="../../scripts/board.js"></script>
</Document>
