---
// The document every page is rendered into: <head>, the skip link, the four-corner header, the page (the slot: a
// React page component from src/screens/), and the Contact footer. The only .astro file besides the routes.
import '@portfolio/ui/styles.css';
import { getCollection } from 'astro:content';
import { grounds, type Ground } from '@portfolio/tokens';
import type { Current } from '@portfolio/ui';
import { Header, SiteFooter } from '../chrome';
import Tweaks from '../components/Tweaks.astro';
import { isPublished } from '../lib/placeholder';
import { siteFor } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Which part of the site the page is: sets aria-current in the header, and og:type ('article' for a case study). */
  current: Current;
  /** A log entry (aria-current="true" on the Log link) rather than the log index ("page"). */
  entry?: boolean;
  /** Share-card image (path relative to the site root). Every page uses the site card, assets/share-card.png (the name
      beside the XSIM frame, rendered from tools/share-card.html), unless it passes its own. */
  ogImage?: { src: string; width: number; height: number; alt: string };
  /** Keep the page out of search results (the log index while it has no published entries). */
  noindex?: boolean;
  /** The page's ground (E2, warm): one per project, paper for the index pages. See .impeccable.md. */
  ground?: Ground;
}
const card = { src: 'assets/share-card.png', width: 1200, height: 630, alt: 'Gonzalo Ferrero Martín, BSc Electrical Engineering at TU/e, Eindhoven: PCB design, Verilog on FPGAs, embedded C, and the testbenches that check the result. Beside it, the 640 by 480 frame his XSIM testbench produced: three red ramps inside the hatched blanking of the 800 by 525 frame.' };
const { title, description, current, entry = false, ogImage = card, noindex = false, ground = 'paper' } = Astro.props;
const site = siteFor(Astro.url, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const article = current === 'work-case' || entry;
// the 404 page is served at any depth on the user site: root-relative, like /_astro/, so it works on any host
const R = /^https?:/.test(site.root) ? '/' : site.root;
const theme = grounds[ground].g;
const hasLog = (await getCollection('log', isPublished)).length > 0;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
<meta name="theme-color" content={theme}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content={article ? 'article' : 'website'}>
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="Gonzalo Ferrero Martín">
<meta property="og:locale" content="en_US">
<meta property="og:image" content={new URL(ogImage.src, Astro.site).href}>
<meta property="og:image:width" content={String(ogImage.width)}>
<meta property="og:image:height" content={String(ogImage.height)}>
<meta property="og:image:alt" content={ogImage.alt}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/svg+xml" href={`${R}assets/favicon.svg`}>
<link rel="preload" href={`${R}fonts/anybody-var.woff2`} as="font" type="font/woff2" crossorigin>
<script src="../scripts/site.js"></script>
</head>
<body data-ground={ground}>
<a class="skip" href="#main">Skip to content</a>
<Header site={site} current={current} entry={entry} hasLog={hasLog} />

<slot />

<SiteFooter site={site} />
{import.meta.env.DEV && <Tweaks />}
</body>
</html>
