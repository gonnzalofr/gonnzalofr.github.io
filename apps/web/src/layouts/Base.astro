---
import '@portfolio/ui/styles.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Tweaks from '../components/Tweaks.astro';
import type { Kind } from '../components/Nav.astro';
import { grounds, type Ground } from '@portfolio/tokens';

export type { Ground };

interface Props {
  title: string;
  description: string;
  kind: Kind;
  /** 0 for root pages, 1 for work/ and log/ pages: sets the "../" prefix on every relative href. */
  depth: 0 | 1 | 'abs';
  /** A log entry (aria-current="true" on the Log link) rather than the log index ("page"). */
  entry?: boolean;
  /** Share-card image (path relative to the site root). Every page uses the site card, assets/share-card.png (the name
      beside the XSIM frame, rendered from tools/share-card.html), unless it passes its own. */
  ogImage?: { src: string; width: number; height: number; alt: string };
  /** Keep the page out of search results (the log index while it has no published entries). */
  noindex?: boolean;
  /** The page's ground (E2, warm): one per project, paper for the index pages. See .impeccable.md. */
  ground?: Ground;
}
const card = { src: 'assets/share-card.png', width: 1200, height: 630, alt: 'Gonzalo Ferrero Martín, BSc Electrical Engineering at TU/e, Eindhoven: PCB design, Verilog on FPGAs, embedded C, and the testbenches that check the result. Beside it, the 640 by 480 frame his XSIM testbench produced: three red ramps inside the hatched blanking of the 800 by 525 frame.' };
const { title, description, kind, depth, entry = false, ogImage = card, noindex = false, ground = 'paper' } = Astro.props;
const P = depth === 'abs' ? new URL('./', Astro.site).href : depth ? '../' : '';   // 'abs': the 404 page, served at any depth
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const article = kind === 'work-case' || entry;
const R = depth === 'abs' ? '/' : P;   // the 404 page is served at any depth on the user site: root-relative, like /_astro/, so it works on any host
const theme = grounds[ground].g;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
<meta name="theme-color" content={theme}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content={article ? 'article' : 'website'}>
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="Gonzalo Ferrero Martín">
<meta property="og:locale" content="en_US">
<meta property="og:image" content={new URL(ogImage.src, Astro.site).href}>
<meta property="og:image:width" content={String(ogImage.width)}>
<meta property="og:image:height" content={String(ogImage.height)}>
<meta property="og:image:alt" content={ogImage.alt}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/svg+xml" href={`${R}assets/favicon.svg`}>
<link rel="preload" href={`${R}fonts/anybody-var.woff2`} as="font" type="font/woff2" crossorigin>
<script src="../scripts/site.js"></script>
</head>
<body data-ground={ground}>
<a class="skip" href="#main">Skip to content</a>
<header class="head">
  <a class="head__name" href={`${P}index.html`}>Gonzalo Ferrero Martín</a>
  <Nav kind={kind} depth={depth} entry={entry} />
</header>

<slot />

<Footer />
{import.meta.env.DEV && <Tweaks />}
</body>
</html>
